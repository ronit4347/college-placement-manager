# Local development PostgreSQL connection details. Never use these in production.
POSTGRES_DB=college_placement_manager
POSTGRES_USER=placement_app
POSTGRES_PASSWORD=replace-with-a-local-url-safe-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://placement_app:replace-with-a-local-url-safe-password@localhost:5432/college_placement_manager

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local frontend origin used by backend CORS. Set to the deployed frontend origin in production.
FRONTEND_URL=http://localhost:5173

# Resume analysis provider: mock (default) or gemini
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_RESUME_CHARACTERS=30000

# Local development resume storage and upload limit
RESUME_UPLOAD_DIR=backend/uploads/resumes
MAX_RESUME_SIZE_BYTES=5242880

# Optional local demo seed. Enable only for a development database.
DEMO_SEED_ENABLED=false
DEMO_ADMIN_PASSWORD=
DEMO_STUDENT_PASSWORD=
DEMO_RECRUITER_PASSWORD=
DEMO_INTERVIEWER_PASSWORD=
